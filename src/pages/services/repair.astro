---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Plumbing Repair | ${SITE_TITLE}`} description="Expert plumbing repair in Yucaipa, CA. Leaks, toilets, faucets, pipes, and more. Fast diagnosis and lasting fixes." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Plumbing Repair</h1>
			<p>Reliable repairs for leaks, fixtures, and pipes throughout Yucaipa.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Common Plumbing Repairs We Handle</h2>
					<p>From a dripping faucet to a hidden slab leak, we diagnose the problem accurately and fix it the right way — so it stays fixed.</p>
					<ul>
						<li>Leaky faucets and shower valves</li>
						<li>Running or clogged toilets</li>
						<li>Pipe leaks and pipe repair / replacement</li>
						<li>Garbage disposal repair</li>
						<li>Low water pressure issues</li>
						<li>Sump pump and backflow problems</li>
						<li>Fixture repairs and part replacements</li>
					</ul>
					
					<h3>Our Repair Process</h3>
					<ul>
						<li>Clear diagnosis of the issue</li>
						<li>Upfront pricing before work begins</li>
						<li>Quality parts and workmanship</li>
						<li>Cleanup and testing before we leave</li>
					</ul>
				</div>
				<div>
					<h3>Why Prompt Repair Matters</h3>
					<p>Small leaks and minor issues can lead to water damage, mold, higher water bills, and more expensive repairs if left alone. Calling a local plumber early often saves money and stress.</p>
					
					<h3>Serving Yucaipa Homes</h3>
					<p>We work on both older and newer homes in Yucaipa and nearby communities. Whether you have galvanized, copper, or PEX piping, we have the tools and experience to handle the job.</p>
					
					<div class="mt-2">
						<a href="/contact/" class="btn btn-primary">Request Repair Quote</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Need a Plumbing Repair?</h2>
			<p>Call today for fast, professional service in Yucaipa.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
