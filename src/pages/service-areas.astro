---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, ADDRESS } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Service Areas | ${SITE_TITLE}`} description="Plumbing repair and service serving Yucaipa, Calimesa, Redlands, Mentone, Beaumont, and the greater Inland Empire in California." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Service Areas</h1>
			<p>Proudly serving Yucaipa and surrounding Inland Empire communities.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Where We Work</h2>
					<p>We are a local plumbing company focused on residential and light commercial service throughout Yucaipa and nearby cities. We understand the unique plumbing needs of Southern California homes — hard water, older pipe materials, and seasonal demand — and we service systems accordingly.</p>
					
					<h3>Primary Service Areas</h3>
					<ul>
						<li><strong>Yucaipa, CA</strong> — Our home base. Full service for all neighborhoods.</li>
						<li>Calimesa, CA</li>
						<li>Redlands, CA</li>
						<li>Mentone, CA</li>
						<li>Beaumont, CA</li>
						<li>Cherry Valley</li>
						<li>Oak Glen and nearby communities</li>
					</ul>
					
					<h3>Not Sure If We Cover Your Area?</h3>
					<p>If you live near Yucaipa and need plumbing repair, drain cleaning, or water heater service, give us a call. We often serve additional nearby communities and will let you know quickly if we can help.</p>
				</div>
				<div>
					<h3>Our Location</h3>
					<p>{ADDRESS}</p>
					<div class="map-wrapper mt-2">
						<iframe
							src="https://maps.google.com/maps?q=33520+Liberty+Rd,+Yucaipa,+CA+92399&t=&z=15&ie=UTF8&iwloc=&output=embed"
							title="Map showing 33520 Liberty Rd, Yucaipa, CA 92399"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Serving Your Neighborhood</h2>
			<p>Call today to schedule plumbing service in Yucaipa or nearby communities.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
